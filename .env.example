MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?appName=<app-name>

# Furniture shop event API (see Day 1 Participant Guide)
FURNITURE_API_BASE_URL=https://<base-url>
FURNITURE_API_KEY=<your assigned key>
FURNITURE_API_USER_ID=<your assigned user_id, e.g. u001>

# Azure OpenAI for the AI shopping assistant chat
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<your Azure OpenAI API key>
AZURE_OPENAI_API_VERSION=<api version, e.g. 2024-12-01-preview>
AZURE_OPENAI_DEPLOYMENT=<your deployment name, e.g. gpt-5-mini>
 